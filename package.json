    "idb-keyval": "^6.2.2",
    "jsdoc": "github:Alpaq92/JSDoc#main",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.1",
    "motion": "^12.23.24",
    "msdoc-viewer": "github:zheng2429/msdoc-viewer#main",
    "next": "^16.3.3",
    "react": "19.2.6",
