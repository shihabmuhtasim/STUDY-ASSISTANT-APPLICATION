  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 3000",
    "build": "vinext build",
    "start": "vinext start",
    "deploy:cloudflare": "npm run build && vinext-cloudflare deploy --config dist/server/wrangler.json --skip-build",
