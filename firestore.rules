rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownsProfile(userId);

      allow create: if ownsProfile(userId)
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoURL', 'plan', 'questionsUsed',
          'questionLimit', 'createdAt', 'lastLoginAt'
        ])
        && request.resource.data.plan == 'free'
        && request.resource.data.questionsUsed == 0
        && request.resource.data.questionLimit == 100;

      allow update: if ownsProfile(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'lastLoginAt'
        ]);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
