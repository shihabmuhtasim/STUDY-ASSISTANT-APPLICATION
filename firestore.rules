rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownsProfile(userId);

      allow create: if ownsProfile(userId)
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoURL', 'plan', 'questionsUsed',
          'questionLimit', 'createdAt', 'lastLoginAt'
        ])
        && request.resource.data.plan == 'pro'
        && request.resource.data.questionsUsed == 0
        && request.resource.data.questionLimit == 1000000;

      allow update: if ownsProfile(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'plan', 'questionLimit', 'lastLoginAt'
        ])
        && request.resource.data.plan == 'pro'
        && request.resource.data.questionLimit == 1000000;

      allow delete: if false;
    }

    match /users/{userId}/documents/{documentId} {
      allow read, create, update, delete: if ownsProfile(userId);

      match /pages/{pageId} {
        allow read, create, update, delete: if ownsProfile(userId);
      }
    }

    match /users/{userId}/settings/{settingId} {
      allow read, create, update, delete: if ownsProfile(userId);
    }

    match /users/{userId}/aiConnections/{connectionId} {
      allow read, create, update, delete: if ownsProfile(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
